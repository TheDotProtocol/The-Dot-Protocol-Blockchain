# ─── Marketing Mode ─────────────────────────────────────────────────
# Set to "true" to show realistic demo data (for marketing/launch).
# Set to "false" to show only live on-chain data.
MARKETING_MODE=true
NEXT_PUBLIC_MARKETING_MODE=true

# ─── API ────────────────────────────────────────────────────────────
PORT=3006
JWT_SECRET=change-me-to-random-64-hex-chars
NODE_ENV=development

# ─── Contract Addresses (after deployment) ──────────────────────────
NEXT_PUBLIC_ESCROW_ADDRESS=
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_PRESALE_ADDRESS=
NEXT_PUBLIC_DPC20_ADDRESS=

# ─── RPC Endpoints ──────────────────────────────────────────────────
NEXT_PUBLIC_RPC_TESTNET=http://localhost:8545
NEXT_PUBLIC_RPC_MAINNET=http://localhost:9545
# Production:
# NEXT_PUBLIC_RPC_TESTNET=https://rpc-chennai.thedotprotocol.com
# NEXT_PUBLIC_RPC_MAINNET=https://rpc.thedotprotocol.com
